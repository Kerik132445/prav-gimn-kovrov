# ==============================================================================
# КОНФИГУРАЦИЯ СЕРВЕРА И ПОЧТОВЫХ УВЕДОМЛЕНИЙ (SMTP)
# ЧОУ «Православная гимназия г. Коврова»
# ==============================================================================
# Скопируйте этот файл в `.env` и укажите свои параметры для работы почты.
# ПРИМЕЧАНИЕ: Если SMTP не настроен, сайт и форма обратной связи продолжают
# полноценно работать, а все обращения сохраняются в базе данных gymnasium.db.
# ==============================================================================

# Хост SMTP сервера (например: smtp.gmail.com, smtp.yandex.ru, smtp.mail.ru)
SMTP_HOST=smtp.gmail.com

# Порт SMTP (587 для STARTTLS, 465 для SSL)
SMTP_PORT=587

# Логин / Email учетной записи отправителя
SMTP_USER=your_email@gmail.com

# Пароль приложения (App Password) для SMTP (не основной пароль от почты!)
# Для Gmail: Создается в Google Аккаунт -> Безопасность -> Двухэтапная аутентификация -> Пароли приложений
SMTP_PASSWORD=your_app_specific_password_here

# Использовать STARTTLS (true/false)
SMTP_USE_TLS=true

# Использовать прямое SSL подключение (обычно true для порта 465)
SMTP_USE_SSL=false

# Email отправителя (если отличается от SMTP_USER)
SMTP_FROM_EMAIL=your_email@gmail.com

# Email адрес получателя уведомлений о новых обращениях
NOTIFICATION_EMAIL=kerik1pii@gmail.com
